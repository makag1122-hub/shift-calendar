<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:paddingLeft="11dp"
    android:paddingTop="9dp"
    android:paddingRight="11dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/widget_previous"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_nav_button"
            android:gravity="center"
            android:text="‹"
            android:textColor="#596174"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:text="@string/widget_default_title"
            android:textColor="#1F2533"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingLeft="10dp" />

        <TextView
            android:id="@+id/widget_group"
            android:layout_width="45dp"
            android:layout_height="32dp"
            android:layout_marginRight="6dp"
            android:background="@drawable/widget_group_chip"
            android:gravity="center"
            android:maxLines="1"
            android:text="A조"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_next"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_nav_button"
            android:gravity="center"
            android:text="›"
            android:textColor="#596174"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_calendar_image"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:adjustViewBounds="true"
        android:contentDescription="@string/widget_calendar_description"
        android:scaleType="fitCenter"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="7dp" />

    <TextView
        android:id="@+id/widget_footer"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:background="@drawable/widget_footer_background"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:paddingLeft="11dp"
        android:paddingRight="11dp"
        android:text="@string/widget_open_hint"
        android:textColor="#525D73"
        android:textSize="11sp"
        android:textStyle="bold" />

</LinearLayout>
