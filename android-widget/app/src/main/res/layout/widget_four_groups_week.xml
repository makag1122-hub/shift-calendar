<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:paddingLeft="9dp"
    android:paddingTop="6dp"
    android:paddingRight="9dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="2dp">

        <TextView
            android:id="@+id/week_widget_previous"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/widget_nav_button"
            android:gravity="center"
            android:text="‹"
            android:textColor="#596174"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/week_widget_title"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingLeft="8dp"
            android:text="이번 주"
            android:textColor="#1F2533"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="50dp"
            android:layout_height="26dp"
            android:layout_marginRight="5dp"
            android:background="@drawable/widget_group_chip"
            android:gravity="center"
            android:maxLines="1"
            android:text="4개 조"
            android:textColor="#FFFFFF"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/week_widget_next"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/widget_nav_button"
            android:gravity="center"
            android:text="›"
            android:textColor="#596174"
            android:textSize="19sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageView
        android:id="@+id/week_widget_image"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="2dp"
        android:layout_weight="1"
        android:adjustViewBounds="true"
        android:contentDescription="@string/week_widget_calendar_description"
        android:scaleType="fitXY" />

</LinearLayout>
